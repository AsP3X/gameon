                {
                  "type": "text",
                  "id": "Lfayc",
                  "name": "Follow the suit that was led if you can.",
                  "context": "li",
                  "fill": "$fg",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 42,
                  "content": "Follow the suit that was led if you can. Special cards can always be played.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "sI56u",
                  "name": "Black Jolly Roger cards trump the other ",
                  "context": "li",
                  "fill": "$fg",
                  "content": "Black Jolly Roger cards trump the other suits.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "i0rWyv",
                  "name": "Mermaids beat numbers, Pirates beat Merm",
                  "context": "li",
                  "fill": "$fg",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 63,
                  "content": "Mermaids beat numbers, Pirates beat Mermaids, the Skull King beats Pirates, and a Mermaid catches the Skull King.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "pOUOV",
                  "name": "When two equal specials meet, the first ",
                  "context": "li",
                  "fill": "$fg",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 63,
                  "content": "When two equal specials meet, the first one played wins. Tigress plays as a Pirate or an Escape.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                }
              ]
            },

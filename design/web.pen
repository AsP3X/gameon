                      "content": "Seats",
                      "lineHeight": 1.4,
                      "fontFamily": "$f-ui",
                      "fontSize": 15,
                      "fontWeight": "900"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "A5Re2",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "From 700 the other pirates sit on the felt as plates, clockwise from your left: left edge, top edge, right edge. Up to 3 opponents take one edge each; 4 or 5 put two or three on top; 6 or 7 put two left, two or three on top, two right.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                }
              ]
            },
            {
              "type": "frame",
              "id": "c7ASf2",

                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "p9JsTC",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A game is a run of rounds, and in most games each round deals one card more than the last. Every round goes the same way: first everybody bids, then the tricks are played.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]

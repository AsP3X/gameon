                    {
                      "type": "text",
                      "id": "Kn5hn",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Look at your cards and say how many tricks you will win. Zero is a bid too. Everybody bids in secret, and the bids are turned over together.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "jkLL6",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "From then on that number is yours to hit. One trick too many is as wrong as one too few.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"

                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "yziPd",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One game against bots or on one screen is saved in this browser, so that you can pick it up later. It never leaves the device, and “Forget this game” at Skull King’s home drops it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "LJHuM",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A scoresheet for a game with real cards, your sound settings, this device’s own stats, your last table settings and a note from Suggest a game are kept the same way: in this browser, and nowhere else.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,

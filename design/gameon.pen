                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "WhCJE",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The session cookie",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "aWgT3",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One cookie keeps this browser signed in. The page cannot read it, and it is sent to this site only. Signing out ends it. The page loads nothing from other sites.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "N8X1DW",
                  "name": "Block · The games the server stores",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "axsGd",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The games the server stores",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "RquZG",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A game played on the server is stored with its deals and its moves in order, so that it can be replayed exactly. Your results, your stats and your rating come from those games. Your finished games are listed on your profile, and only the players who sat in a game can open its record.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "TiTHn",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When you walk out of a ranked game, the server keeps how often you have done so this season, and until when ranked stays closed for you. The ladder shows neither.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "RDxTu",
                  "name": "Block · What other players see",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "FoCiT",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What other players see",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "kB1oJ",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The ladder is public. It shows your display name, your colour, your tier and your rating. It does not show your username, and neither does your page as other players see it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wBW46",
                  "name": "Block · On this device",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,

              "gap": 16,
              "children": [
                {
                  "type": "frame",
                  "id": "DQK8L",
                  "name": "Block · A hand",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "UjK2W",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A hand",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "p9JsTC",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A game is a run of rounds, and in most games each round deals one card more than the last. Every round goes the same way: first everybody bids, then the tricks are played.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "VwaHp",
                  "name": "Block · A bid",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "ExxAa",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A bid",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "xAMB5",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Look at your cards and say how many tricks you will win. Zero is a bid too. Everybody bids in secret, and the bids are turned over together.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "CCJk5",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "From then on that number is yours to hit. One trick too many is as wrong as one too few.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 16,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "QOjrP",
                  "name": "Block · A trick",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [

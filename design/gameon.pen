                  "children": [
                    {
                      "type": "text",
                      "id": "nwwSL",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your account",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "jGqM6",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A guest has a display name and a colour, and is asked for nothing else. An account adds a username and a password. The password is stored as a hash: the site cannot read it back.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "cYXh7",
                  "name": "Block · The session cookie",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "oOHzH",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The session cookie",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "n2Hayn",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One cookie keeps this browser signed in. The page cannot read it, and it is sent to this site only. Signing out ends it. The page loads nothing from other sites.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Zs2JQ",
                  "name": "Block · The games the server stores",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "B6SOn",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The games the server stores",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "goGsQ",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A game played on the server is stored with its deals and its moves in order, so that it can be replayed exactly. Your results, your stats and your rating come from those games. Your finished games are listed on your profile, and only the players who sat in a game can open its record.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "Ie3bq",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When you walk out of a ranked game, the server keeps how often you have done so this season, and until when ranked stays closed for you. The ladder shows neither.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "XIjSi",
                  "name": "Block · What other players see",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "DiU3U",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What other players see",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "XTHxC",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The ladder is public. It shows your display name, your colour, your tier and your rating. It does not show your username, and neither does your page as other players see it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "cCUoE",
                  "name": "Block · On this device",
                  "width": "fill_container",
                  "fill": "$card",
                  "cornerRadius": 20,
                  "stroke": "$line",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "C2NO9",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "On this device",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"
                    },
                    {
                      "type": "text",
                      "id": "RkyjW",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One game against bots or on one screen is saved in this browser, so that you can pick it up later. It never leaves the device, and “Forget this game” at Skull King’s home drops it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "p8E1b",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A scoresheet for a game with real cards, your sound settings, this device’s own stats, your last table settings and a note from Suggest a game are kept the same way: in this browser, and nowhere else.",
                      "lineHeight": 1.55,
                      "fontFamily": "$f-ui",
                      "fontSize": 17,
                      "fontWeight": "700"
                    }
                  ]

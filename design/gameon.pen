                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A bid",
                      "lineHeight": 1.2,
                      "fontFamily": "$f-ui",
                      "fontSize": 20,
                      "fontWeight": "900"

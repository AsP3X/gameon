                  "name": "Head",
                  "width": 220,
                  "children": [
                    {
                      "type": "text",
                      "id": "Z2mhn",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Plate states",
                      "lineHeight": 1.4,
                      "fontFamily": "$f-ui",
                      "fontSize": 15,
                      "fontWeight": "900"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "ifH3U",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "White with a line border at rest, blue when it is that seat's turn, green when the seat took the trick. The same colours the phone seat uses. Online, the clock ring and the OFFLINE, AWAY and BOT tags sit on the avatar exactly as on the phone, scaled with it.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                }
              ]
            },
            {
              "type": "frame",
              "id": "vzKul",
              "name": "Rule · The felt",
              "width": "fill_container",
              "gap": 16,
              "children": [
                {
                  "type": "frame",

          "fontFamily": "$f-ui",
          "fontSize": 20,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "b4kWc",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "2 · One home with four ways in: Solo, One screen, Online, Ranked. The old Home and the “Play online” hub are gone.",
          "lineHeight": 1.4,
          "fontFamily": "$f-ui",
          "fontSize": 20,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "cusew",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",

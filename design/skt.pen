        {
          "type": "text",
          "id": "t1vSN",
          "name": "The ring empties as the deadline comes. ",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The ring empties as the deadline comes. When it is empty the table plays for that seat. A tag says where a player is: offline, away, out, or replaced by a bot. Out is a player who was offline for two turns in a row. The table plays for that seat from then on, with no ring, and the player can't come back to it. A bot only takes the seat of a player who left.",
          "lineHeight": 1.4,
          "fontFamily": "$f-ui",
          "fontSize": 13,
          "fontWeight": "700"
        }
      ]

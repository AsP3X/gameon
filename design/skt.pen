                  "name": "Head",
                  "width": 220,
                  "children": [
                    {
                      "type": "text",
                      "id": "WE3cU",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The felt",
                      "lineHeight": 1.4,
                      "fontFamily": "$f-ui",
                      "fontSize": 15,
                      "fontWeight": "900"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "fjpI1",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Holds the trick in play order with each player's chip under the card (more than 4 cards wrap into two rows), the status line, and from 700 also what the phone shows under the hand: the bid panel and the ability choices, at most 520 wide.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,
                  "fontWeight": "700"
                }
              ]
            },
            {
              "type": "frame",

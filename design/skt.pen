                {
                  "type": "text",
                  "id": "GNWm7",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tablet portrait keeps the phone's strip above the hand. From 1024 your seat is a plate left of the hand and the hand is centred under the felt. Cards sit side by side until they no longer fit, then overlap evenly.",
                  "lineHeight": 1.4,
                  "fontFamily": "$f-ui",
                  "fontSize": 15,

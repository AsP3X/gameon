# The first ./deploy.sh on a terminal opens setup and writes .env from these defaults.
# ./deploy.sh --setup opens that screen again, starting from the current .env.
# A start without a terminal copies this file. .env is not committed.
# Saving setup rewrites the keys below and leaves every other line alone.

# local publishes host ports. npm joins the external proxy-network and publishes none:
# Nginx Proxy Manager reaches the containers by name, so no host port is required.
PROXY_MODE=local

# Host ports for PROXY_MODE=local only. Setup does not ask for these when PROXY_MODE=npm.
API_PORT=8080
WEB_PORT=8081

RUST_LOG=info

# The page's origin when it is not http://localhost or http://127.0.0.1.
# No path. Example: https://tavern.example
SKT_PUBLIC_ORIGIN=

# Set to 1 when the page is served over https. Leave empty for local http.
SKT_SECURE_COOKIE=

# Local Postgres. The API container uses the hostname `postgres` instead of 127.0.0.1.
# POSTGRES_PORT is the published host port for PROXY_MODE=local. NPM does not publish it.
# The database itself is the named volume skt_pg_data unless SKT_DATA_DIR is set below.
POSTGRES_PORT=5432
POSTGRES_USER=skt
POSTGRES_PASSWORD=skt
POSTGRES_DB=skt
DATABASE_URL=postgres://skt:skt@127.0.0.1:5432/skt

# Comma-separated addresses and CIDRs that may set X-Forwarded-For and X-Real-IP.
# Empty when the API is reached directly (cargo run). The Compose file defaults this
# to 172.16.0.0/12, which is the Docker bridge skt-web uses.
SKT_TRUSTED_PROXIES=

# Optional. Leave this unset to keep the named volume skt_pg_data.
# A path stores Postgres in <path>/database/pgdata. ./deploy.sh --data-dir ./data sets it.
# ./deploy.sh --named-volumes removes it. ./deploy.sh --reset deletes the database and .env.
# SKT_DATA_DIR=./data

# Optional. Comma-separated Docker networks for each container.
# Leave these unset to keep skt-internal, and in NPM mode also proxy-network on the
# API and the page. skt-internal is always attached. The setup screen edits these.
# ./deploy.sh creates a listed network when it is missing.
# SKT_NETWORKS_POSTGRES=skt-internal
# SKT_NETWORKS_API=skt-internal,proxy-network
# SKT_NETWORKS_WEB=skt-internal,proxy-network

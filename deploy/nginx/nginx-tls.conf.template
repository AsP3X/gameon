# HTTPS for a host that has its own certificate. HTTP redirects.

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    # stderr, so Docker keeps this stream. notice is the image default.
    error_log stderr ${NGINX_LOG_LEVEL};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    absolute_redirect off;
    port_in_redirect off;
    client_max_body_size 1m;

    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;

    # API_UPSTREAM must be http://skt-api:8080, not the shared service name api.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        include /etc/nginx/api-proxy.conf;
        set $skt_api ${API_UPSTREAM};
        proxy_pass $skt_api;
    }

    location /assets/ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(mp3|wav|ogg)$ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        gzip off;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # The worker and the manifest must be fetched again after a deploy. A long
    # lifetime would keep serving the previous file list.
    location = /sw.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        types { }
        default_type application/javascript;
        try_files $uri =404;
    }

    location = /manifest.json {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        types { }
        default_type application/json;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

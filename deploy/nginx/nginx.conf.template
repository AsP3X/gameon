# Rendered by the nginx image envsubst entrypoint.
# Substitutes ${API_UPSTREAM} and ${NGINX_LOG_LEVEL}. Other $names are nginx variables.
# API_UPSTREAM is http://gameon-api:8080. Do not use the service name api: on a
# shared proxy-network Docker DNS returns every service of that name.

server {
    listen 80;
    server_name _;
    # stderr, so Docker keeps this stream. notice is the image default.
    error_log stderr ${NGINX_LOG_LEVEL};

    root /usr/share/nginx/html;
    index index.html;

    absolute_redirect off;
    port_in_redirect off;

    # Posts are small JSON intents. The menu track is a response, not an upload.
    client_max_body_size 1m;

    include /etc/nginx/security-headers.conf;

    # Text only. MP3 and WAV do not shrink, and audio/mpeg stays out of this list.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Skull King lobby and socket. Accounts stay on the API.
    location /api/v1/ws {
        include /etc/nginx/api-proxy.conf;
        set $skt_game ${SKT_GAME_UPSTREAM};
        proxy_pass $skt_game;
    }

    location /api/v1/lobbies {
        include /etc/nginx/api-proxy.conf;
        set $skt_game ${SKT_GAME_UPSTREAM};
        proxy_pass $skt_game;
    }

    location /api/v1/metrics {
        include /etc/nginx/api-proxy.conf;
        set $skt_game ${SKT_GAME_UPSTREAM};
        proxy_pass $skt_game;
    }

    location /api/ {
        include /etc/nginx/api-proxy.conf;
        set $skt_api ${API_UPSTREAM};
        proxy_pass $skt_api;
    }

    # Ocho lobby and table. The API still owns the session cookie.
    location /ocho/ {
        include /etc/nginx/api-proxy.conf;
        set $ocho ${OCHO_UPSTREAM};
        proxy_pass $ocho;
    }

    # Hashed build output, including tavern-<hash>.mp3. One long cache lifetime.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Fetch the whole file. Do not compress it.
    location ~* \.(mp3|wav|ogg)$ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        gzip off;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # The worker and the manifest must be fetched again after a deploy. A long
    # lifetime would keep serving the previous file list.
    location = /sw.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        types { }
        default_type application/javascript;
        try_files $uri =404;
    }

    location = /manifest.json {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        types { }
        default_type application/json;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

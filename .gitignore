server/target/

# Web client
/web/node_modules/
/web/dist/

# OS and editors
.DS_Store
.idea/
*.swp

# Local preview servers of a Claude Code session (absolute paths to a worktree)
/.claude/launch.json

# Local secrets. Never commit.
.env

# Database dumps from ./deploy.sh --backup
/backups/

# Optional Postgres folder from ./deploy.sh --data-dir. Named volumes are the default.
/data/

# Compose network overlay written by ./deploy.sh. The next start replaces it.
/.deploy/
